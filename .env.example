# Porta do servidor
PORT=3000

# Senha do painel (usuário: admin). Deixe vazio só para testes locais.
ADMIN_PASSWORD=troque-esta-senha

# --- Instagram (Meta) ---
# Token de acesso da conta profissional do Instagram (Instagram API com login do Instagram)
IG_ACCESS_TOKEN=
# ID da sua conta profissional do Instagram (IG User ID)
IG_USER_ID=
# Segredo do app Meta (valida a assinatura dos webhooks)
META_APP_SECRET=
# Texto qualquer que você escolhe e repete no painel da Meta ao configurar o webhook
WEBHOOK_VERIFY_TOKEN=um-texto-secreto-qualquer

# Versão da Graph API
IG_API_VERSION=v21.0

# Caminho do banco SQLite
DB_PATH=./data/domus.db
